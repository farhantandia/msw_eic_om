# ==============================================================================
# Git Ignore Configuration - Outage EIC Work Order Monitoring System
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# PyInstaller Build & Dist Artifacts (keeps root server.exe and server.spec)
build/
dist/
*.manifest

# Backup & Archive Directories (Auto-generated outage backups & manual backups)
Data list/
Archive/
Backup/
*.bak
*.bak_*
*.backup

# Scratch & Temporary Testing Scripts
scratch/

# Application Logs & Temporary System Artifacts
*.log
.tempmediaStorage/
.system_generated/
*.tmp
*.temp

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
